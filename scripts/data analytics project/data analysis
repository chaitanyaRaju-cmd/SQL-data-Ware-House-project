/* we are doing data analytics project */

use datawarehouse

/* we can explore the different objects which are in the database */

select * from INFORMATION_SCHEMA.tables

/* we can explore the columns in the database as well */

select* from INFORMATION_SCHEMA.COLUMNS
-- we can even do this for required table like

select* from INFORMATION_SCHEMA.COLUMNS
where TABLE_NAME = 'dim_customers'

-- DIMENSION EXPLORATION 

/* explore all the countries our customers come from */

select distinct
	cu.customer_country
from gold.dim_customers as cu

/* explore all product categories "the major divisions" */

select distinct
	pr.product_category,
	pr.product_subcategory,
	pr.product_name
from gold.dim_products as pr
order by 1,2,3

/* DATE EXPLORATION */

/* what are the earliest date and latest date in our data */
-- date boundary 
-- find the date of first order and the last order

select 
	min(fs.sls_order_dt) as first_order_date,
	max(fs.sls_order_dt) as last_order_date
from gold.fact_sales as fs

/* how many years of sales , months of sales dates are available */

select 
	DATEDIFF(year,min(fs.sls_order_dt),max(fs.sls_order_dt)) as available_years
from gold.fact_sales as fs
--
select 
	DATEDIFF(MONTH,min(fs.sls_order_dt),max(fs.sls_order_dt)) as available_months
from gold.fact_sales as fs

/* find the youngest and oldest customer */

select
	cu.customer_firstname,
	min(cu.customer_birthdate) as oldest_customer,
	DATEDIFF(YEAR,min(cu.customer_birthdate),getdate()) as oldest_cu_age,
	max(cu.customer_birthdate) as oldest_customer,
	DATEDIFF(YEAR,max(cu.customer_birthdate),getdate()) as youngest_cu_age
from gold.dim_customers as cu

/* MEASURES EXPLORATION */

/* find the total sales */

select 
	sum(fs.sls_sales) as total_sales
from gold.fact_sales as fs

/* show how many items are sold */

select 
	count(dp.product_id) as total_number_items
from gold.dim_products as dp

/* show how much quantity in total is sold */

select 
	sum(fs.sls_quantity) as total_qty
from gold.fact_sales as fs

/* find the average selling price */

select 
	avg(fs.sls_price) as average_price
from gold.fact_sales as fs

/* find the total number of orders */

select
	count(distinct fs.sls_ord_num) as total_num_orders
from gold.fact_sales as fs

/* find the total number of customers */

select 
	count(cu.customer_id) as total_num_customers
from gold.dim_customers as cu

/* find the total number of customers that placed order */

select 
	count(distinct cu.customer_id) as total_num_customers_pl_or
from gold.dim_customers as cu

/* MAGNITUDE ANALYSIS */

/* find the total number of customers by country */

select 
	cu.customer_country,
	count(cu.customer_id) as total_num_cu
from gold.dim_customers as cu
group by cu.customer_country

/* find total num of customers by gender */

select 
	cu.customer_gender,
	count(cu.customer_id) as total_num_cu
from gold.dim_customers as cu
group by cu.customer_gender

/* find total num of products by category */

select 
	dp.product_category,
	count(dp.product_id) as total_num_prd
from gold.dim_products as dp
group by dp.product_category

/* what is the average costs in each category */

select 
	dp.product_category,
	avg(dp.product_cost) as average_cost
from gold.dim_products as dp
group by dp.product_category

/* total revenue for each category */

select 
	dp.product_category,
	sum(fs.sls_sales) as total_revenue
from gold.fact_sales as fs
left join gold.dim_products as dp
on fs.product_key = dp.product_key
group by dp.product_category

/* total revenue generated by each customer */

select 
	cu.customer_id,
	cu.customer_firstname,
	sum(fs.sls_sales) as total_revenue
from gold.fact_sales as fs
left join gold.dim_customers as cu
on fs.customer_key = cu.customer_key
group by 
		cu.customer_id,
		cu.customer_firstname

/* RANKING ANALYSIS */

/* which 5 products generate high revenue */

select top 5
	dp.product_name,
	sum(fs.sls_sales) as total_revenue
from gold.fact_sales as fs
left join gold.dim_products as dp
on fs.product_key = dp.product_key
group by dp.product_name 
order by total_revenue desc

--OR

select *
from(
select
	dp.product_name,
	sum(fs.sls_sales) as total_revenue,
	ROW_NUMBER() over(order by sum(fs.sls_sales)desc) as product_rank
from gold.fact_sales as fs
left join gold.dim_products as dp
on fs.product_key = dp.product_key
group by dp.product_name
) t
where product_rank <= 5

/* 5 least product that generate low evenue */

select top 5
	dp.product_name,
	sum(fs.sls_sales) as total_revenue
from gold.fact_sales as fs
left join gold.dim_products as dp
on fs.product_key = dp.product_key
group by dp.product_name 
order by total_revenue asc

-- OR
select *
from(
select
	dp.product_name,
	sum(fs.sls_sales) as total_revenue,
	ROW_NUMBER() over(order by sum(fs.sls_sales)) as product_rank
from gold.fact_sales as fs
left join gold.dim_products as dp
on fs.product_key = dp.product_key
group by dp.product_name
) t
where product_rank <= 5

-- second is dimensin products (we want only current data
--no need to have historical data ,when prd_end_date is null
--it is a current data)

if object_id('gold.dim_products','v') is not null
    drop view gold.dim_products;
go
create view gold.dim_products as
select
       ROW_NUMBER() over(order by cp.[prd_start_dt],cp.[prd_key]) as product_key
      ,cp.[prd_id] as product_id
      ,cp.[prd_key] as product_number
      ,cp.[prd_nm] as product_name
      ,ep.CAT as product_category
      ,cp.[cat_id] as category_id
      ,ep.SUBCAT as product_subcategory
      ,cp.[prd_line] as product_line
      ,cp.[prd_cost] as product_cost
      ,cp.[prd_start_dt] as product_start_date
      ,ep.MAINTENANCE as product_maintenance
from silver.crm_prd_info as cp
left join silver.erp_PX_CAT_G1V2 as ep
on cp.cat_id = ep.ID
where cp.prd_end_dt is null


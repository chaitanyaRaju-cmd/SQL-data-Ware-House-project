-- creating fact sales

create view gold.fact_sales as
SELECT
    cs.sls_ord_num,
    pr.product_key,
    dc.customer_key,
    cs.sls_order_dt,
    cs.sls_ship_dt,
    cs.sls_due_dt,
    cs.sls_sales,
    cs.sls_quantity,
    cs.sls_price
FROM silver.crm_sales_details AS cs
LEFT JOIN gold.dim_products AS pr
    ON REPLACE(cs.sls_prd_key, '-', '_') = pr.product_number
LEFT JOIN gold.dim_customers AS dc
    ON cs.sls_cust_id = dc.customer_id;

/* now we are doing data look up, in this above table we see two columns 
which are coming from products and customers, as we have created surrogate keys
which are customer_key and product_key they should be joined here */


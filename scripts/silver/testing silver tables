/* testing silver table */

/* now we are checking each table from the bronze layer
where any required changes has to be done to make the data 
correct and accurate */

-- first table

select *
from silver.crm_cust_info

/* check for nulls or duplicates inside the primary key
which is cst_id column */

select 
	cst_id,
	count(*)
from silver.crm_cust_info
group by cst_id
having count(*) > 1 or cst_id is null

/* check the string value columns for unwanted
spaces */

select 
	cst_firstname  -- cst_lastname or any string valued column, make changes accordingly
from silver.crm_cust_info
where cst_firstname != trim(cst_firstname)

/* check data consistency and standardization */

select distinct
	cst_gndr      -- cst_marital_status
from silver.crm_cust_info

/* testing second silver table */

-- second table

select *
from silver.crm_prd_info

/* check for nulls or duplicates inside the primary key
which is cst_id column */

select 
	prd_id,
	count(*)
from silver.crm_prd_info
group by prd_id
having count(*) > 1 or prd_id is null

/* split the prd_key column into cat_id column and
prd_key column as they are useful further
we should identify these things */

/* check the string value columns for unwanted
spaces */

select 
	prd_nm
from silver.crm_prd_info
where prd_nm != trim(prd_nm)

/* check for any negitive or null values */

select 
	prd_cost
from silver.crm_prd_info
where prd_cost != abs(prd_cost) or prd_cost is null

/* check data consistency and standardization */

select distinct 
	prd_line
from silver.crm_prd_info

/* check the dates columns , check if end date is
less than start date */

select 
	*
from silver.crm_prd_info
where prd_end_dt < prd_start_dt

/* testing silver table */

use datawarehouse

/* now we are checking each table from the bronze layer
where any required changes has to be done to make the data 
correct and accurate */

-- first table

select *
from silver.crm_cust_info

/* check for nulls or duplicates inside the primary key
which is cst_id column */

select 
	cst_id,
	count(*)
from silver.crm_cust_info
group by cst_id
having count(*) > 1 or cst_id is null

/* check the string value columns for unwanted
spaces */

select 
	cst_firstname  -- cst_lastname or any string valued column, make changes accordingly
from silver.crm_cust_info
where cst_firstname != trim(cst_firstname)

/* check data consistency and standardization */

select distinct
	cst_gndr      -- cst_marital_status
from silver.crm_cust_info

/* testing second silver table */

-- second table

select *
from silver.crm_prd_info

/* check for nulls or duplicates inside the primary key
which is cst_id column */

select 
	prd_id,
	count(*)
from silver.crm_prd_info
group by prd_id
having count(*) > 1 or prd_id is null

/* split the prd_key column into cat_id column and
prd_key column as they are useful further
we should identify these things */

/* check the string value columns for unwanted
spaces */

select 
	prd_nm
from silver.crm_prd_info
where prd_nm != trim(prd_nm)

/* check for any negitive or null values */

select 
	prd_cost
from silver.crm_prd_info
where prd_cost != abs(prd_cost) or prd_cost is null

/* check data consistency and standardization */

select distinct 
	prd_line
from silver.crm_prd_info

/* check the dates columns , check if end date is
less than start date */

select 
	*
from silver.crm_prd_info
where prd_end_dt < prd_start_dt

/* third table */

select *
from silver.crm_sales_details

--check for unwanted spaces in string valued columns

select
	sls_ord_num
from silver.crm_sales_details
where sls_ord_num != trim(sls_ord_num)

-- check if sls_prd_key column can be used to join other tables
-- similarly check for sls_cust_id

/* check for invalid dates */
-- we should think of different ways how the dates could be 
--have a bad quality

select
	nullif(sls_order_dt,0) as sls_order_dt
from silver.crm_sales_details
where sls_order_dt <= 0 or len(sls_order_dt) != 8

-- working well--

-- check for sls_ship_dt and sls_due_dt as well
-- check if order date is greater than ship date or 
-- order date is greater than due date

select *
from silver.crm_sales_details
where sls_order_dt > sls_ship_dt or sls_order_dt > sls_due_dt

/* for checking sls_sales , sls_quantity , sls_price there is
a business rule sales = quantity * price and sales should not be
negitive or null or zero */

select distinct
	sls_sales,
	sls_quantity,
	sls_price
from silver.crm_sales_details
where sls_sales != sls_quantity * sls_price 
or sls_sales is null
or sls_sales <= 0
or sls_quantity is null
or sls_quantity <= 0
or sls_price is null 
or sls_price <= 0
order by sls_sales, sls_quantity , sls_price

SELECT TOP (1000) [cst_id]
      ,[cst_key]
      ,[cst_firstname]
      ,[cst_lastname]
      ,[cst_marital_status]
      ,[cst_gndr]
      ,[cst_create_date]
  FROM [datawarehouse].[bronze].[crm_cust_info]

  /* here we have cst_id and cst_key columns displaying
  id number of customer and key number of customer */

  SELECT TOP (1000) [prd_id]
      ,[prd_key]
      ,[prd_nm]
      ,[prd_cost]
      ,[prd_line]
      ,[prd_start_dt]
      ,[prd_end_dt]
  FROM [datawarehouse].[bronze].[crm_prd_info]

/* here we have prd_id column and prd_key column displaying
product id number and product key number */

SELECT TOP (1000) [sls_ord_num]
      ,[sls_prd_key]
      ,[sls_cust_id]
      ,[sls_order_dt]
      ,[sls_ship_dt]
      ,[sls_due_dt]
      ,[sls_sales]
      ,[sls_quantity]
      ,[sls_price]
  FROM [datawarehouse].[bronze].[crm_sales_details]

  /* here we have sls_ord_num column which have 
  sales order number , sls_prd_key column which have
  sales product key values , sls_cust_id column which have
  sales customer id number */

  SELECT TOP (1000) [CID]
      ,[BDATE]
      ,[GEN]
  FROM [datawarehouse].[bronze].[erp_CUST_AZ12]

/* here we have CID column , BDATE column and GEN column */

SELECT TOP (1000) [CID]
      ,[CNTRY]
  FROM [datawarehouse].[bronze].[erp_LOC_A101]

  /* here we have CID and CNTRY columns */

SELECT TOP (1000) [ID]
      ,[CAT]
      ,[SUBCAT]
      ,[MAINTENANCE]
  FROM [datawarehouse].[bronze].[erp_PX_CAT_G1V2]

/* here we have ID , CAT column (category) , SUBCAT (subcategory)
and MAINTENANCE column */

